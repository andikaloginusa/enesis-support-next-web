# Dependencies — never copy into the image (will be installed fresh)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next
out

# Git & IDE
.git
.gitignore
.vscode
.idea

# Environment files — injected at runtime via docker-compose
.env
.env.*

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# OS artifacts
.DS_Store
Thumbs.db

# CI / test artifacts
coverage
*.pem
*.tsbuildinfo
next-env.d.ts
README.md
